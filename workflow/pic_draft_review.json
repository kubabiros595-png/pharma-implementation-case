    {
      "id": "0aa337d0-b201-4f30-947f-2788c2024c71",
      "name": "Summarize decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Summarize decisions for the reviewer (or the test). Nothing is sent anywhere.\nconst items = $('Check decisions').all().map(i => i.json).filter(r => !r.nothing);\nconst count = d => items.filter(r => r.decision === d).length;\nreturn [{ json: {\n  source: $('Collect decisions').first().json.source,\n  results: items.map(r => ({ enquiry_id: r.enquiry_id, decision: r.decision, valid: r.valid, reason: r.reason })),\n  summary: 'Approved: ' + count('approved') + ', approved with edits: ' + count('approved_with_edits') + ', rejected: ' + count('rejected') +\n    ', blocked: ' + items.filter(r => !r.valid).length + '. Nothing was sent. Approved means ready for a human to send.'\n} }];\n"
      },
      "executeOnce": true
    },
