    {
      "id": "71fca787-024b-4af1-b599-05bd1816dc40",
      "name": "Check decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Check decisions: validate each decision against the current queue row before anything is saved.\n// An edit must keep the [Source: ...] line, contain no forbidden phrases and no personal data.\nconst REVIEW_VERSION = 'pic-draft-review v1.0';\nconst FORBIDDEN = [\n  /\\byou should (take|stop|start|increase|decrease|use|apply)\\b/i, /\\bstop taking\\b/i,\n  /\\b(increase|decrease|double|halve) (your|the) dose\\b/i, /\\bsafe for you\\b/i, /\\bcompletely safe\\b/i,\n  /\\b100% safe\\b/i, /\\bno side effects\\b/i, /\\bguarantee/i, /\\bcures?\\b/i, /\\bI recommend\\b/i,\n  /\\bwe recommend\\b/i, /\\bin my opinion\\b/i, /\\bdiagnos/i, /\\bno need to see (a|your) doctor\\b/i\n];\nconst PII = [/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i, /(?<![\\w-])\\d{6,}(?![\\w-])/];\nconst c = $('Collect decisions').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nconst byRowId = new Map(rows.map(r => [String(r.id), r]));\nconst byEnquiry = new Map(rows.map(r => [r.enquiry_id, r]));\nconst now = $now.toISO();\nconst out = [];\nfor (const d of c.decisions || []) {\n  const choice = String(d.decision || 'keep pending').trim();\n  if (choice === 'keep pending') continue;\n  const row = d.row_id !== undefined ? byRowId.get(String(d.row_id)) : byEnquiry.get(d.enquiry_id);\n  const note = String(d.note || '').trim();\n  const base = { actor: c.actor, at: now, note, review_version: REVIEW_VERSION };\n  if (!row) { out.push({ json: { ...base, valid: false, enquiry_id: d.enquiry_id || String(d.row_id), row_id: null, decision: 'not_found', new_status: '', final_text: '', source_id: '', source_version: '', reason: 'no draft waiting for review with this id' } }); continue; }\n  const citation = '[Source: ' + row.source_id + ' v' + row.source_version + ']';\n  let valid = true, decision = choice, newStatus = 'pending_review', text = row.draft_text, reason = '';\n  if (choice === 'approve') { decision = 'approved'; newStatus = 'approved'; reason = 'ready for a human to send from the MI mailbox'; }\n  else if (choice === 'reject') {\n    if (!note) { valid = false; decision = 'reject_blocked'; reason = 'a reason is required to reject'; }\n    else { decision = 'rejected'; newStatus = 'rejected'; reason = 'rejected by reviewer'; }\n  } else if (choice === 'edit') {\n    const edited = String(d.edited_text || '').trim();\n    const problems = [];\n    if (!edited) problems.push('empty text');\n    if (!edited.includes(citation)) problems.push('source line ' + citation + ' missing or changed');\n    const bad = FORBIDDEN.filter(re => re.test(edited));\n    if (bad.length) problems.push('forbidden phrase');\n    if (PII.some(re => re.test(edited))) problems.push('personal data');\n    if (problems.length) { valid = false; decision = 'edit_blocked'; reason = problems.join('; '); }\n    else { decision = 'approved_with_edits'; newStatus = 'approved'; text = edited; reason = 'edited and approved; ready for a human to send'; }\n  } else { valid = false; decision = 'unknown_decision'; reason = 'unknown decision: ' + choice; }\n  out.push({ json: { ...base, valid, enquiry_id: row.enquiry_id, row_id: row.id, decision, new_status: newStatus, final_text: text, source_id: row.source_id, source_version: row.source_version, reason } });\n}\nif (!out.length) return [{ json: { nothing: true } }];\nreturn out;\n"
      }
    },
