    {
      "id": "cf7dd709-3ca5-473b-9f72-4021d2762e0f",
      "name": "Build review page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build review page: one card per draft waiting for review, with a decision, an editable text and a note.\nconst rows = $input.all().map(i => i.json).filter(r => r.id && r.status === 'pending_review');\nif (!rows.length) return [{ json: { has_pending: false, pending_count: 0 } }];\n// Text from the table or the AI is shown as plain text, never as HTML.\nconst escapeHtml = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/\\n/g, '<br>');\nconst formFields = rows.flatMap(r => [\n  { fieldType: 'html', elementName: 'card_' + r.id, html: [\n    '<hr>',\n    '<h3>' + escapeHtml(r.enquiry_id) + ' (' + escapeHtml(r.product) + ', ' + escapeHtml(r.requester_type) + ')</h3>',\n    '<p><b>Enquiry (masked):</b> ' + escapeHtml(r.masked_text) + '</p>',\n    '<p><b>Why this queue:</b> ' + escapeHtml(r.rationale) + '</p>',\n    '<p><b>Source:</b> ' + escapeHtml(r.source_id) + ' v' + escapeHtml(r.source_version) + ' &nbsp; <b>Checks:</b> ' + escapeHtml(r.checks) + '</p>',\n    '<p><b>Draft:</b><br>' + escapeHtml(r.draft_text) + '</p>'\n  ].join('') },\n  { fieldLabel: 'Decision for ' + r.enquiry_id, fieldName: 'decision_' + r.id, fieldType: 'dropdown', requiredField: true, defaultValue: 'keep pending',\n    fieldOptions: { values: [{ option: 'keep pending' }, { option: 'approve' }, { option: 'reject' }, { option: 'edit' }] } },\n  { fieldLabel: 'Edited text for ' + r.enquiry_id + ' (only used with \"edit\"; keep the [Source: ...] line)', fieldName: 'edit_' + r.id, fieldType: 'textarea', defaultValue: r.draft_text, requiredField: false },\n  { fieldLabel: 'Note for ' + r.enquiry_id + ' (required when rejecting)', fieldName: 'note_' + r.id, fieldType: 'text', requiredField: false }\n]);\nreturn [{ json: { has_pending: true, pending_count: rows.length, row_ids: rows.map(r => r.id), form_fields: formFields } }];\n"
      }
    },
    {
