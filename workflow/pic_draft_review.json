    {
      "id": "4fab3121-5e77-4768-862e-686e41c0b0bc",
      "name": "Collect decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collect decisions: one list of decisions, whether they came from the review form or from the test workflow.\nconst j = $input.first().json;\nlet source, actor, decisions = [];\nif (j.decisions_json !== undefined) {\n  source = 'test';\n  actor = String(j.actor || 'test runner');\n  try { decisions = JSON.parse(j.decisions_json); } catch (err) { decisions = []; }\n} else {\n  source = 'form';\n  // The review form requires an n8n login; the trigger passes the signed-in user.\n  let user = {};\n  try { const t = $('Open draft review').first().json; user = t.user || t.n8nUser || {}; } catch (err) { user = {}; }\n  actor = 'n8n user: ' + (user.email || user.id || [user.firstName, user.lastName].filter(Boolean).join(' ') || 'unknown');\n  let ids = [];\n  try { ids = $('Build review page').first().json.row_ids || []; } catch (err) { ids = []; }\n  decisions = ids.map(id => ({\n    row_id: id,\n    decision: j['decision_' + id] ?? 'keep pending',\n    edited_text: j['edit_' + id] ?? '',\n    note: j['note_' + id] ?? ''\n  }));\n}\nreturn [{ json: { source, actor, decisions } }];\n"
      }
    },
    {
      "id": "c316d7f6-6603-4d8e-b880-90c57e2fa281",
      "name": "Load current drafts",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1440,
        200
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "PIC Queue"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
