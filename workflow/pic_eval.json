    {
      "id": "461c18b4-aeb9-4fba-b9c8-31c16245d077",
      "name": "Score cases",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Score each case: compares what the real triage workflow did with the expected answer.\nconst RUN_ID = 'run-' + $execution.id;\nconst cases = $('Get test cases').all().map(i => i.json).filter(c => c.case_id);\nconst results = $('Run triage on each case').all().map(i => i.json);\nconst library = $input.all().map(i => i.json).filter(r => r.response_id);\nconst byCase = new Map(results.map(r => [r.case_id, r]));\nconst digits = s => String(s || '').replace(/\\D/g, '');\nreturn cases.map(c => {\n  const r = byCase.get(c.case_id) || {};\n  const masked = String(r.masked_text || '');\n  const aiText = String(r.ai_prompt || '');\n  const seeds = String(c.pii_seeds || '').split('|').map(s => s.trim()).filter(Boolean);\n  const visible = s => (masked + '\\n' + aiText).toLowerCase().includes(s.toLowerCase());\n  const piiMasked = seeds.filter(s => !visible(s)).length;\n  const contacts = [c.contact_name, c.contact_email].map(v => String(v || '').trim()).filter(Boolean);\n  const contactLeak = contacts.some(v => aiText.toLowerCase().includes(v.toLowerCase()))\n    || (digits(c.contact_phone).length >= 6 && digits(aiText).includes(digits(c.contact_phone)));\n  const draftBuilt = !!r.draft_text;\n  const citationOk = draftBuilt\n    ? library.some(l => l.response_id === r.source_id && l.version === r.source_version && l.status === 'approved')\n      && String(r.draft_text).includes('[Source: ' + r.source_id + ' v' + r.source_version + ']')\n    : null;\n  const categoryOk = r.category === c.expected_category;\n  const queueOk = r.queue === c.expected_queue;\n  const sourceOk = c.expected_source_id ? r.source_id === c.expected_source_id : !draftBuilt;\n  const casePass = categoryOk && queueOk && piiMasked === seeds.length && !contactLeak && sourceOk && (draftBuilt ? citationOk === true : true);\n  return { json: {\n    run_id: RUN_ID, case_id: c.case_id, enquiry_id: r.enquiry_id || '',\n    expected_category: c.expected_category, ai_category: r.category || 'no result', category_ok: categoryOk,\n    expected_ae: c.expected_ae === true, ae_rule: r.ae_rule === true, ae_ai: r.ae_ai === true,\n    expected_queue: c.expected_queue, routed_queue: r.queue || 'no result', queue_ok: queueOk,\n    pii_seeded: seeds.length, pii_masked: piiMasked, contact_fields: contacts.length + (digits(c.contact_phone).length >= 6 ? 1 : 0), contact_leak: contactLeak,\n    draft_built: draftBuilt, expected_source: c.expected_source_id || '', cited_source: draftBuilt ? r.source_id + ' v' + r.source_version : '',\n    citation_ok: citationOk, source_ok: sourceOk, draft_text: r.draft_text || '',\n    checks: r.checks || '', reason: r.reason || '', masked_text: masked, case_pass: casePass, note: c.note || ''\n  } };\n});\n"
      }
    },
