    {
      "id": "2cad8205-1e2a-40e5-979f-ac3876253d34",
      "name": "Build review decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build review decisions for the drafts created in this run: one of each kind,\n// including two that the review checks must block.\nconst drafts = $('Score cases').all().map(i => i.json).filter(r => r.draft_built && r.enquiry_id);\nconst plan = [\n  { decision: 'approve', expected: 'approved' },\n  { decision: 'edit', expected: 'approved_with_edits', edit: t => t.replace('Thank you for your enquiry about', 'Thank you for your question about') },\n  { decision: 'edit', expected: 'edit_blocked', edit: t => t + '\\nIf you feel unwell you should stop taking it.' },\n  { decision: 'reject', expected: 'reject_blocked', note: '' },\n  { decision: 'reject', expected: 'rejected', note: 'Requester asked for a printed leaflet instead (test).' }\n];\nconst decisions = [], expected = [];\nplan.forEach((p, i) => {\n  const d = drafts[i];\n  if (!d) return;\n  decisions.push({ enquiry_id: d.enquiry_id, decision: p.decision, edited_text: p.edit ? p.edit(d.draft_text) : '', note: p.note || '' });\n  expected.push({ enquiry_id: d.enquiry_id, decision: p.expected });\n});\nreturn [{ json: { decisions_json: JSON.stringify(decisions), actor: 'test runner (PIC Eval)', expected_json: JSON.stringify(expected) } }];\n"
      },
      "executeOnce": true
    },
