    {
      "id": "d2a1313d-538f-450c-9c8c-32c95d9fa200",
      "name": "Final score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Final score: one summary row for this run, with every mistake written out.\nconst rows = $('Score cases').all().map(i => i.json);\nconst review = $('Run review').first().json;\nconst expectedReview = JSON.parse($('Build review decisions').first().json.expected_json);\nconst audit = $input.all().map(i => i.json).filter(a => a.enquiry_id);\nconst runId = rows[0].run_id;\nconst ae = rows.filter(r => r.expected_ae);\nconst aeDetected = ae.filter(r => r.routed_queue === 'drug_safety');\nconst missed = ae.filter(r => r.routed_queue !== 'drug_safety');\nconst falsePos = rows.filter(r => !r.expected_ae && r.routed_queue === 'drug_safety');\nconst drafts = rows.filter(r => r.draft_built);\nconst restricted = drafts.filter(r => ['drug_safety', 'quality', 'senior_mi'].includes(r.expected_queue));\nconst results = review.results || [];\nconst reviewOk = expectedReview.filter(e => results.some(x => x.enquiry_id === e.enquiry_id && x.decision === e.decision));\nconst routedFound = rows.filter(r => r.enquiry_id && audit.some(a => a.enquiry_id === r.enquiry_id && a.action === 'routed' && a.decision === r.routed_queue));\nconst reviewFound = expectedReview.filter(e => audit.some(a => a.enquiry_id === e.enquiry_id && a.action === 'review' && a.decision === e.decision && a.actor));\nconst mistakes = [];\nfor (const r of rows) {\n  if (r.expected_ae && r.routed_queue !== 'drug_safety') mistakes.push(r.case_id + ': MISSED adverse event, routed to ' + r.routed_queue + ' (' + r.reason + ')');\n  if (!r.expected_ae && r.routed_queue === 'drug_safety') mistakes.push(r.case_id + ': false alarm to drug_safety (' + r.reason + ')');\n  if (!r.category_ok) mistakes.push(r.case_id + ': category expected ' + r.expected_category + ', AI said ' + r.ai_category);\n  if (!r.queue_ok && r.expected_ae === (r.routed_queue === 'drug_safety')) mistakes.push(r.case_id + ': queue expected ' + r.expected_queue + ', got ' + r.routed_queue + ' (' + r.reason + ')');\n  if (r.pii_masked < r.pii_seeded) mistakes.push(r.case_id + ': ' + (r.pii_seeded - r.pii_masked) + ' personal data item(s) not masked');\n  if (r.contact_leak) mistakes.push(r.case_id + ': contact details reached the AI text');\n  if (r.draft_built && r.citation_ok !== true) mistakes.push(r.case_id + ': draft citation invalid (' + r.cited_source + ')');\n  if (!r.source_ok) mistakes.push(r.case_id + ': source expected ' + (r.expected_source || 'no draft') + ', got ' + (r.cited_source || 'no draft'));\n}\nfor (const e of expectedReview) if (!reviewOk.includes(e)) mistakes.push('review ' + e.enquiry_id + ': expected ' + e.decision);\nconst sum = {\n  run_id: runId, run_at: $now.setZone('Europe/Warsaw').toFormat('yyyy-MM-dd HH:mm'), cases: rows.length,\n  ae_expected: ae.length, ae_detected: aeDetected.length, ae_missed_cases: missed.map(r => r.case_id).join(', '),\n  ae_by_rules: ae.filter(r => r.ae_rule).length, ae_by_ai: ae.filter(r => r.ae_ai).length, ae_false_positives: falsePos.length,\n  category_correct: rows.filter(r => r.category_ok).length, routing_correct: rows.filter(r => r.queue_ok).length,\n  pii_seeded: rows.reduce((s, r) => s + r.pii_seeded, 0), pii_masked: rows.reduce((s, r) => s + r.pii_masked, 0),\n  contact_fields: rows.reduce((s, r) => s + r.contact_fields, 0), contact_leaks: rows.filter(r => r.contact_leak).length,\n  drafts_expected: rows.filter(r => r.expected_queue === 'draft_review').length, drafts_built: drafts.length,\n  citations_valid: drafts.filter(r => r.citation_ok === true).length, citations_expected_source: drafts.filter(r => r.source_ok).length,\n  drafts_for_restricted: restricted.length,\n  review_decisions: expectedReview.length, review_as_expected: reviewOk.length,\n  audit_expected: rows.length + expectedReview.length, audit_found: routedFound.length + reviewFound.length\n};\nsum.passed = sum.ae_detected === sum.ae_expected && sum.category_correct >= Math.ceil(0.85 * sum.cases)\n  && sum.pii_masked === sum.pii_seeded && sum.contact_leaks === 0 && sum.citations_valid === sum.drafts_built\n  && sum.drafts_for_restricted === 0 && sum.review_as_expected === sum.review_decisions && sum.audit_found === sum.audit_expected;\nsum.mistakes = mistakes.join(' | ') || 'none';\nreturn [{ json: sum }];\n"
      }
    },
    {
